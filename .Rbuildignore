^.*\.Rproj$
^\.Rproj\.user$
^\.github$
^\.git$
^\.gitignore$
^\.gitattributes$
^CITATION\.cff$
LICENSE
^doc$
^Meta$
^\.aider
^\.env$
^MAFW/
^playground/
^CLAUDE\.md$
^tests/test_workflow\.md$
diff_0.1.5_*

# Ignore non-standard top-level files from build
^AGENTS\.md$
^VAD\.md$
^model-registry\.md$
^debug_.*\.R$
^trump1\.jpg$
^\.create_metrics_table$
^\.claude(/|$)
^\.ropeproject(/|$)
^WARP\.md$
^QWEN\.md$
misc/
changes.md

# CRAN check output files
^cran_check.*\.txt$
^final_check\.txt$
^.*\.Rcheck$
^\.\.Rcheck$
^CRAN_CHECK_SUMMARY\.md$
^transforEmotion_final_check\.txt$

# Issues and project management files
^issues-.*\.md$

# R project file
transforEmotion\.Rproj

# Docker image for offline use
^docker$
^\.dockerignore$

# Colab notebook
^notebooks$

# Scripts that build files in inst/extdata
^data-raw$

# Python bytecode. Do not ignore inst/doc: R CMD build copies vignette
# output there and then applies .Rbuildignore, so ignoring it strips the
# vignettes from the tarball and install fails.
^inst/python/__pycache__/
\.pyc$

# Knitted from vignettes/*.Rmd by a local knit
^vignettes/.*\.R$

# README logo. No help page uses it, and installing it under help/figures
# pushed the package over CRAN's 5 MB installed-size note.
^man/figures/logo\.png$

# Notes for the CRAN submission form
^cran-comments\.md$
